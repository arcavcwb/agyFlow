    },
    {
      "id": "agy-1156",
      "type": "text",
      "x": 136,
      "y": 1670,
      "width": 408,
      "height": 280.8,
      "angle": 0,
      "strokeColor": "#506677",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "agy-1149",
      "roundness": null,
      "seed": 1156,
      "version": 1,
      "versionNonce": 2156,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789200000000,
      "created": 1789200000000,
      "link": null,
      "locked": false,
      "text": "Principio Fundamental:\nEl conocimiento del proyecto proviene exclusivamente de los archivos leídos en la sesión actual.\n\nNormas Operativas:\n• Si un tipo de API, esquema de base de datos o parámetro no existe en packages/contracts: prohibido inventarlo.\n\n• El agente debe detenerse y reportar el bloqueo formalmente en su respuesta de entrega.\n\n• Frontend Dev NUNCA define tipos de dominio locales para saltarse contratos pendientes.\n\n• QA NUNCA asume que la ausencia de fallos equivale a criterios cumplidos.\n\n• DevOps NUNCA asume que un build exitoso sustituye a un dictamen de QA aprobado.\n\nBeneficio:\nElimina el 99% de las alucinaciones estructurales típicas de las IAs.",
      "originalText": "Principio Fundamental:\nEl conocimiento del proyecto proviene exclusivamente de los archivos leídos en la sesión actual.\n\nNormas Operativas:\n• Si un tipo de API, esquema de base de datos o parámetro no existe en packages/contracts: prohibido inventarlo.\n\n• El agente debe detenerse y reportar el bloqueo formalmente en su respuesta de entrega.\n\n• Frontend Dev NUNCA define tipos de dominio locales para saltarse contratos pendientes.\n\n• QA NUNCA asume que la ausencia de fallos equivale a criterios cumplidos.\n\n• DevOps NUNCA asume que un build exitoso sustituye a un dictamen de QA aprobado.\n\nBeneficio:\nElimina el 99% de las alucinaciones estructurales típicas de las IAs.",
      "fontSize": 13,
      "fontFamily": 2,
      "lineHeight": 1.35,
      "baseline": 13,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    },
