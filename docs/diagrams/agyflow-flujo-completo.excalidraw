      "text": "REGLA 1: CERO ASUNCIÓN",
      "originalText": "REGLA 1: CERO ASUNCIÓN",
      "fontSize": 17,
      "fontFamily": 2,
      "lineHeight": 1.35,
      "baseline": 17,
