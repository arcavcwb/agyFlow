      "text": "REGLA 2: CIRCUIT BREAKER",
      "originalText": "REGLA 2: CIRCUIT BREAKER",
      "fontSize": 17,
      "fontFamily": 2,
      "lineHeight": 1.35,
      "baseline": 17,
      "textAlign": "left",
      "verticalAlign": "top",
