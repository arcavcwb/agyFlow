    },
    {
      "id": "agy-1016",
      "type": "text",
      "x": 856,
      "y": 360,
      "width": 648,
      "height": 70.2,
      "angle": 0,
      "strokeColor": "#506677",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
