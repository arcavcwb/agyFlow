      "locked": false,
      "text": "Regla de Cero Asunción",
      "originalText": "Regla de Cero Asunción",
      "fontSize": 17,
      "fontFamily": 2,
      "lineHeight": 1.35,
      "baseline": 17,
      "textAlign": "left",
      "verticalAlign": "top",
